<?xml version="1.0" encoding="utf-8"?>
<!-- The full plate: the verse in the middle, its reference under it, and the
     next prayer the app itself calculated. The compact layout carries the
     same view ids, so the provider can fill either of them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/moment_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/moment_lens"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="آیت"
            android:src="@drawable/moment_widget_lens" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="آیت / حدیثِ وقت"
            android:textColor="#FFE2AF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/moment_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/moment_widget_button"
            android:contentDescription="اگلا قول"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFE2AF" />
    </LinearLayout>

    <!-- The provider sets the real text size from the line's length (short
         lines larger, long ones smaller but readable); maxLines is generous
         so the words wrap inside the cell instead of being cut, with the
         ellipsis only as a last resort in the smallest cells. -->
    <TextView
        android:id="@+id/moment_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingExtra="3dp"
        android:maxLines="8"
        android:textColor="#FFF9EF"
        android:textDirection="anyRtl"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/moment_next_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/moment_widget_chip"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:textColor="#FFE2AF"
            android:textDirection="anyRtl"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/moment_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#C4D3D0"
            android:textDirection="anyRtl"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/moment_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#C4D3D0"
        android:textDirection="anyRtl"
        android:textSize="11sp" />
</LinearLayout>
