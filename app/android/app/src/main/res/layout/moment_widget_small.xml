<?xml version="1.0" encoding="utf-8"?>
<!-- The compact plate: the same verse, in a cell too small for the reference
     and the next prayer. It carries the same view ids as the full plate, so
     the provider fills either of them without changing anything else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/moment_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/moment_lens"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="آیت"
            android:src="@drawable/moment_widget_lens" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="آیت"
            android:textColor="#FFE2AF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/moment_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/moment_widget_button"
            android:contentDescription="اگلا قول"
            android:padding="7dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFE2AF" />
    </LinearLayout>

    <!-- As on the full plate, the provider sizes this text from its length;
         it may wrap to five short lines before the ellipsis is allowed. -->
    <TextView
        android:id="@+id/moment_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingExtra="2dp"
        android:maxLines="5"
        android:textColor="#FFF9EF"
        android:textDirection="anyRtl"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moment_next_prayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/moment_widget_chip"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFE2AF"
        android:textDirection="anyRtl"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/moment_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#C4D3D0"
        android:textDirection="anyRtl"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/moment_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#C4D3D0"
        android:textDirection="anyRtl"
        android:textSize="10sp" />
</LinearLayout>
