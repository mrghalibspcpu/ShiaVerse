<?xml version="1.0" encoding="utf-8"?>
<!-- Compact, three-line quote layout for short cells. It keeps the source and
     refresh control, while the next-prayer and Hijri chips move to the full
     layout. The provider fills both layouts through the same view ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/moment_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/moment_lens"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="آیت"
            android:src="@drawable/moment_widget_lens" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="آیت"
            android:textColor="#FFE2AF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/moment_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/moment_widget_button"
            android:contentDescription="اگلا قول"
            android:padding="5dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFE2AF" />
    </LinearLayout>

    <TextView
        android:id="@+id/moment_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:textColor="#FFF9EF"
        android:textDirection="anyRtl"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moment_next_prayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/moment_widget_chip"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFE2AF"
        android:textDirection="anyRtl"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/moment_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#C4D3D0"
        android:textDirection="anyRtl"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/moment_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#C4D3D0"
        android:textDirection="anyRtl"
        android:textSize="10sp" />
</LinearLayout>
